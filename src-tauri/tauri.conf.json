{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nine Realms Tauri",
  "version": "../package.json",
  "identifier": "com.sakauma.ninerealms.tauri",
  "build": {
    "beforeBuildCommand": "python3 scripts/build.py",
    "beforeDevCommand": "python3 scripts/build.py",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main",
      "create": false,
      "url": "index.html",
      "title": "九境 · Nine Realms",
      "width": 1320,
      "height": 960,
      "minWidth": 420,
      "minHeight": 680,
      "backgroundColor": "#08151b",
      "visible": false,
      "useHttpsScheme": true,
      "zoomHotkeysEnabled": false,
      "dragDropEnabled": false
    }],
    "security": {
      "capabilities": ["desktop"],
      "assetProtocol": { "enable": false, "scope": [] },
      "csp": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; style-src-attr 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self' data: blob:; worker-src 'self' blob:; connect-src ipc: http://ipc.localhost https://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["../desktop/icon.png", "../desktop/icon.ico"],
    "publisher": "Nine Realms",
    "category": "Game",
    "licenseFile": "../LICENSE",
    "createUpdaterArtifacts": false,
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": { "installMode": "currentUser", "languages": ["SimpChinese"], "displayLanguageSelector": false, "installerIcon": "../desktop/icon.ico" }
    }
  }
}
